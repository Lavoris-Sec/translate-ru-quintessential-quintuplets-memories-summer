[
 {"scene":0,"text":0,"speaker":"Итика","translation":"Ого, сегодняшний салат такой вкусный!"},
 {"scene":0,"text":1,"speaker":"Ёцуба","translation":"Да, овощи такие хрустящие!"},
 {"scene":0,"text":2,"speaker":"Нино","translation":"Эта заправка прекрасно подчёркивает вкус салата."},
 {"scene":0,"text":3,"speaker":"Райха","translation":"Нино-сан права!\\nЗаправка просто потрясающая!"},
 {"scene":0,"text":4,"speaker":"Ёцуба","translation":"Не могу остановиться, Уэсуги-сан!"},
 {"scene":0,"text":5,"speaker":"Футаро","translation":"...Не думал,\\nчто салатом можно наесться."}
]
