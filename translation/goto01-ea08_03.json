[
 {"scene":0,"text":0,"speaker":"Обе","translation":"А-а-а."},
 {"scene":0,"text":1,"speaker":"Футаро","translation":"О, паста с овощами.\\nВыглядит вкусно."},
 {"scene":0,"text":2,"speaker":"Ицуки","translation":"Какой аромат!\\nТакое просто не может быть невкусным!"},
 {"scene":0,"text":3,"speaker":"Ицуки","translation":"Так, Райха-тян, я разложу по тарелкам."},
 {"scene":0,"text":4,"speaker":"Райха","translation":"Спасибо, Ицуки-сан!"},
 {"scene":0,"text":5,"speaker":"Ицуки","translation":"Ну что, приятного аппетита!"},
 {"scene":0,"text":6,"speaker":"Райха","translation":"Приятного аппетита!"},
 {"scene":0,"text":7,"speaker":"Футаро","translation":"А? А где моя порция?"},
 {"scene":0,"text":8,"speaker":"Ицуки","translation":"Вы не ребёнок,\\nможете положить себе сами."}
]
