[
 {"scene":0,"text":0,"speaker":"???","translation":"ДОБРОЕ УТРО-О!\\nУже утро, Уэсуги-сан!"},
 {"scene":0,"text":1,"speaker":"Футаро","translation":"Хр-р..."},
 {"scene":0,"text":2,"speaker":"???","translation":"Уэсуги-сан, Уэсуги-са-ан!\\nУЭСУГИ-САН!"},
 {"scene":0,"text":3,"speaker":"Футаро","translation":"Хр-р..."},
 {"scene":0,"text":4,"speaker":"???","translation":"Ой, тогда я просто войду?"},
 {"scene":0,"text":5,"speaker":"Футаро","translation":"Хр-р..."},
 {"scene":0,"text":6,"speaker":"Ёцуба","translation":"Так! Подтверждаю: цель крепко спит.\\nНачинаем операцию по пробуждению!"},
 {"scene":0,"text":7,"speaker":"Ёцуба","translation":"Сначала СДЁРНЕМ одеяло!"},
 {"scene":0,"text":8,"speaker":"Футаро","translation":"А-А?! Ч-что за чёрт?"},
 {"scene":0,"text":9,"speaker":"Ёцуба","translation":"Подтверждаю: цель проснулась!\\nТеперь последний штрих!"},
 {"scene":0,"text":10,"speaker":"Ёцуба","translation":"Готовы, Уэсуги-сан?\\nПротяните руку."},
 {"scene":0,"text":11,"speaker":"Футаро","translation":"Э, а, вот так?"},
 {"scene":0,"text":12,"speaker":"Ёцуба","translation":"Хорошо, начинаем.\\nИ-и... РАЗ, ДВА!"},
 {"scene":0,"text":13,"speaker":"Футаро","translation":"ОГО?!"},
 {"scene":0,"text":14,"speaker":"Ёцуба","translation":"Цель покинула кровать!\\nЗадание выполнено!"},
 {"scene":0,"text":15,"speaker":"Ёцуба","translation":"Кстати, доброе утро!\\nПохоже, вы проснулись, Уэсуги-сан."},
 {"scene":0,"text":16,"speaker":"Футаро","translation":"Ага, окончательно.\\nДоброе утро, Ёцуба."},
 {"scene":0,"text":17,"speaker":"Футаро","translation":"Но ты так легко вытащила меня из кровати.\\nТы и правда очень сильная."},
 {"scene":0,"text":18,"speaker":"Ёцуба","translation":"Потому что тренируюсь. Если понадобится помощь\\nс физической работой, пожалуйста, скажите.\\nЯ уверена в делах, где не нужно думать!"},
 {"scene":0,"text":19,"speaker":"Футаро","translation":"Нет, не могу я тебя об этом просить."},
 {"scene":0,"text":20,"speaker":"Ёцуба","translation":"А-ха-ха, да, понимаю.\\nЯ так и думала, что вы это скажете."},
 {"scene":0,"text":21,"speaker":"Ёцуба","translation":"Отныне, даже если придётся думать,\\nя постараюсь вам помочь, Уэсуги-сан!"},
 {"scene":0,"text":22,"speaker":"Футаро","translation":"...Ну, главное, не переусердствуй."},
 {"scene":0,"text":23,"speaker":"Ёцуба","translation":"Ладно, переодевайтесь.\\nВсе ждут в гостиной."}
]
