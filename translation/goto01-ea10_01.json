[
 {"scene":0,"text":0,"speaker":"Футаро","translation":"Этот запах...\\nНеужели у нас сегодня%p-2;――"},
 {"scene":0,"text":1,"speaker":"Ёцуба","translation":"Да, мисо-суп со свининой!"},
 {"scene":0,"text":2,"speaker":"Ицуки","translation":"А-А-А-А?!"},
 {"scene":0,"text":3,"speaker":"Футаро","translation":"Ч-что случилось, Ицуки?!"},
 {"scene":0,"text":4,"speaker":"Ицуки","translation":"Р-р-р%p-2;――"},
 {"scene":0,"text":5,"speaker":"Ёцуба","translation":"Р%p-2;――%p;?"},
 {"scene":0,"text":6,"speaker":"Ицуки","translation":"Рис ещё не готов!"},
 {"scene":0,"text":7,"speaker":"Футаро","translation":"А... вот беда..."},
 {"scene":0,"text":8,"speaker":"Ицуки","translation":"Ждать, пока приготовится рис,\\nощущая этот восхитительный аромат супа...\\nЭто трагедия..."}
]
