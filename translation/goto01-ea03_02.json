[
 {"scene":0,"text":0,"speaker":"Ицуки","translation":"Хрум, хрум..."},
 {"scene":0,"text":1,"speaker":"Райха","translation":"Ицуки-сан, салат невкусный?"},
 {"scene":0,"text":2,"speaker":"Ицуки","translation":"А? Вкусный."},
 {"scene":0,"text":3,"speaker":"Райха","translation":"А, хорошо, я рада.\\nТы так тихо ела,\\nчто я подумала, будто он невкусный."},
 {"scene":0,"text":4,"speaker":"Итика","translation":"Вовсе нет.\\nПо-моему, сегодняшний салат отличный."},
 {"scene":0,"text":5,"speaker":"Футаро","translation":"Точно, обычный хороший салат."},
 {"scene":0,"text":6,"speaker":"Райха","translation":"Обычный, значит...\\nНу да, вкус у него и правда привычный, да?"}
]
