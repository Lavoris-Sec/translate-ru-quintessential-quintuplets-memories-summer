[
{"scene":0,"text":0,"speaker":"Футаро","translation":"...Тихо."},
{"scene":0,"text":1,"speaker":"Ицуки","translation":"Да."},
{"scene":0,"text":2,"speaker":"Футаро","translation":"Рыба клюёт?"},
{"scene":0,"text":3,"speaker":"Ицуки","translation":"Удочка уже давно не шевелится."},
{"scene":0,"text":4,"speaker":"Футаро","translation":"У меня тоже."},
{"scene":0,"text":5,"speaker":"Ицуки","translation":"......"},
{"scene":0,"text":6,"speaker":"Футаро","translation":"......"},
{"scene":0,"text":7,"speaker":"Ицуки","translation":"Погода сегодня хорошая.\\nПрекрасный день для рыбалки, правда?"},
{"scene":0,"text":8,"speaker":"Футаро","translation":"Ага.\\nСолнце припекает, так что берегись теплового удара."},
{"scene":0,"text":9,"speaker":"Ицуки","translation":"Да, верно."},
{"scene":0,"text":10,"speaker":"Футаро","translation":"......"},
{"scene":0,"text":11,"speaker":"Ицуки","translation":"Э-э..."},
{"scene":0,"text":12,"speaker":"Ицуки","translation":"(...О-ой, не получается поддержать разговор.)"},
{"scene":0,"text":13,"speaker":"Футаро","translation":"Ицуки?\\nТебе необязательно об этом беспокоиться."},
{"scene":0,"text":14,"speaker":"Ицуки","translation":"О-о чём ты?"},
{"scene":0,"text":15,"speaker":"Футаро","translation":"Ты ведь пыталась заполнить тишину,\\nпока мы рыбачим?"},
{"scene":0,"text":16,"speaker":"Ицуки","translation":"...Раскусил меня?"},
{"scene":0,"text":17,"speaker":"Футаро","translation":"Совсем не обязательно выдавливать из себя\\nразговоры о погоде и тому подобном."},
{"scene":0,"text":18,"speaker":"Футаро","translation":"Я не против помолчать.\\nА если захочешь поговорить,\\nможешь говорить о чём угодно."},
{"scene":0,"text":19,"speaker":"Ицуки","translation":"Уэсуги-кун..."},
{"scene":0,"text":20,"speaker":"Футаро","translation":"При наших отношениях\\nтебе нечего беспокоиться из-за тишины."},
{"scene":0,"text":21,"speaker":"Ицуки","translation":"Хе-хе, и правда."},
{"scene":0,"text":22,"speaker":"Ицуки","translation":"...Наших отношениях?"},
{"scene":0,"text":23,"speaker":"Футаро","translation":"Хм? Что на этот раз?"},
{"scene":0,"text":24,"speaker":"Ицуки","translation":"Н-ничего... Совершенно ничего..."},
{"scene":0,"text":25,"speaker":"Ицуки","translation":"(...Что это он сказал про наши отношения?!\\n Что ты обо мне думаешь, Уэсуги-кун..?!)"},
{"scene":0,"text":26,"speaker":"Футаро","translation":"Ицуки!"},
{"scene":0,"text":27,"speaker":"Ицуки","translation":"А-А?! Ч-что такое?!"},
{"scene":0,"text":28,"speaker":"Футаро","translation":"Твоя удочка! Двигается!"},
{"scene":0,"text":29,"speaker":"Ицуки","translation":"А-а! Точно!\\nН-нужно скорее вытянуть..."},
{"scene":0,"text":30,"speaker":"Ицуки","translation":"А, а-а-а..."},
{"scene":0,"text":31,"speaker":"Футаро","translation":"Уплыла.\\nПотому что ты отвлеклась."},
{"scene":0,"text":32,"speaker":"Ицуки","translation":"Ох... Интересно, кто же в этом виноват?.."}
]
