[
 {"scene":0,"text":0,"speaker":"Футаро","translation":"Хр-р..."},
 {"scene":0,"text":1,"speaker":"???","translation":"Э-эй, Футаро-кун?"},
 {"scene":0,"text":2,"speaker":"Футаро","translation":"(...М? Что это за звук?)"},
 {"scene":0,"text":3,"speaker":"???","translation":"Уже утро, просыпайся."},
 {"scene":0,"text":4,"speaker":"Футаро","translation":"...Что такое, Итика?"},
 {"scene":0,"text":5,"speaker":"Итика","translation":"О? Уже проснулся?\\nДоброе утро, Футаро-кун."},
 {"scene":0,"text":6,"speaker":"Футаро","translation":"Доброе утро.\\nПришла меня разбудить?"},
 {"scene":0,"text":7,"speaker":"Итика","translation":"Верно.\\nВсе уже в гостиной\\nи ждут, когда ты проснёшься."},
 {"scene":0,"text":8,"speaker":"Футаро","translation":"ЧТО?!\\nЯ проспал?!"},
 {"scene":0,"text":9,"speaker":"Итика","translation":"А-ха-ха, шучу.\\nМы ещё готовим завтрак."},
 {"scene":0,"text":10,"speaker":"Футаро","translation":"...Эй, не пугай меня с самого утра."},
 {"scene":0,"text":11,"speaker":"Итика","translation":"Прости, прости.\\nЗато теперь ты окончательно проснулся, правда?"},
 {"scene":0,"text":12,"speaker":"Футаро","translation":"Ага, благодаря тебе."},
 {"scene":0,"text":13,"speaker":"Итика","translation":"Тогда приходи в гостиную, когда соберёшься."},
 {"scene":0,"text":14,"speaker":"Футаро","translation":"Хорошо, до встречи."}
]
