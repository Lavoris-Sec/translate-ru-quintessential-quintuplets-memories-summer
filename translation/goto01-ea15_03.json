[
 {"scene":0,"text":0,"speaker":"Райха","translation":"Ура-а! Ого!\\nЧто это?!"},
 {"scene":0,"text":1,"speaker":"Ёцуба","translation":"Целая гора разноцветных фруктовых ломтиков?!"},
 {"scene":0,"text":2,"speaker":"Итика","translation":"Похоже на десерт с роскошного приёма."},
 {"scene":0,"text":3,"speaker":"Мику","translation":"Так красиво разложено, даже есть жалко."},
 {"scene":0,"text":4,"speaker":"Ицуки","translation":"М-м! Охлаждено в самый раз!\\nВкусно!"},
 {"scene":0,"text":5,"speaker":"Нино","translation":"Э-эй, когда ты успела начать?!"},
 {"scene":0,"text":6,"speaker":"Футаро","translation":"Давайте, ешьте, пока Ицуки всё не съела."},
 {"scene":0,"text":7,"speaker":"Ицуки","translation":"Я-я не стану всё съедать!"}
]
