[
 {"scene":0,"text":0,"speaker":"Футаро","translation":"Я поймал немного рыбы.\\nМожет, пора заканчивать и возвращаться?"},
 {"scene":0,"text":1,"speaker":"Мику","translation":"П-подожди!"},
 {"scene":0,"text":2,"speaker":"Футаро","translation":"М? Что?\\nУ тебя клюёт?"},
 {"scene":0,"text":3,"speaker":"Мику","translation":"Не в этом дело..."},
 {"scene":0,"text":4,"speaker":"Мику","translation":"......"},
 {"scene":0,"text":5,"speaker":"Футаро","translation":"Мику?"},
 {"scene":0,"text":6,"speaker":"Мику","translation":"......"},
 {"scene":0,"text":7,"speaker":"Футаро","translation":"(А?\\n Она смотрит на ведро...)"},
 {"scene":0,"text":8,"speaker":"Мику","translation":"Мне стало немного жалко этих рыб."},
 {"scene":0,"text":9,"speaker":"Футаро","translation":"Рыб, которых мы поймали?"},
 {"scene":0,"text":10,"speaker":"Мику","translation":"...Да."},
 {"scene":0,"text":11,"speaker":"Мику","translation":"Я понимаю...\\nЭта рыба — важная еда для нас.\\nЕсли не принесём её, то не выживем."},
 {"scene":0,"text":12,"speaker":"Мику","translation":"Но..."},
 {"scene":0,"text":13,"speaker":"Футаро","translation":"(Ну вот, она разволновалась из-за рыб.\\n Ох...)"},
 {"scene":0,"text":14,"speaker":"Футаро","translation":"......"},
 {"scene":0,"text":15,"speaker":"Футаро","translation":"Мику, не принимай так близко к сердцу."},
 {"scene":0,"text":16,"speaker":"Мику","translation":"Футаро..."},
 {"scene":0,"text":17,"speaker":"Футаро","translation":"Даже рыбы едят более мелких рыб\\nи других существ, чтобы выжить."},
 {"scene":0,"text":18,"speaker":"Футаро","translation":"Ты и сама сказала: чтобы жить,\\nнам приходится есть других живых существ."},
 {"scene":0,"text":19,"speaker":"Мику","translation":"......"},
 {"scene":0,"text":20,"speaker":"Футаро","translation":"Жалеть их можно,\\nно если попросишь отпустить, я рассержусь."},
 {"scene":0,"text":21,"speaker":"Мику","translation":"......"},
 {"scene":0,"text":22,"speaker":"Футаро","translation":"......"},
 {"scene":0,"text":23,"speaker":"Мику","translation":"Прости, Футаро.\\nЯ была неправа."},
 {"scene":0,"text":24,"speaker":"Футаро","translation":"Хорошо, раз понимаешь.\\nПойдём на виллу."},
 {"scene":0,"text":25,"speaker":"Мику","translation":"Хорошо..."},
 {"scene":0,"text":26,"speaker":"Мику","translation":"...Спасибо, Футаро."},
 {"scene":0,"text":27,"speaker":"Футаро","translation":"Кажется, я ничего такого не сказал?"},
 {"scene":0,"text":28,"speaker":"Мику","translation":"Да...\\nЭто очевидно... Я не должна забывать."},
 {"scene":0,"text":29,"speaker":"Футаро","translation":"......"},
 {"scene":0,"text":30,"speaker":"Футаро","translation":"Добавлю ещё кое-что."},
 {"scene":0,"text":31,"speaker":"Мику","translation":"А?"},
 {"scene":0,"text":32,"speaker":"Футаро","translation":"Твоя доброта никогда не бывает ошибкой."},
 {"scene":0,"text":33,"speaker":"Мику","translation":"...Ты тоже добрый, Футаро."},
 {"scene":0,"text":34,"speaker":"Футаро","translation":"Прекрати.\\nЯ не поэтому это сказал."},
 {"scene":0,"text":35,"speaker":"Мику","translation":"Хи-хи...\\nЛадно, оставим это."}
]
