[
 {"scene":0,"text":0,"speaker":"Футаро","translation":"(М...?\\n О, уже утро...?)"},
 {"scene":0,"text":1,"speaker":"???","translation":"Футаро, ты проснулся?"},
 {"scene":0,"text":2,"speaker":"Футаро","translation":"Ага, доброе утро, Мику.\\nМожешь войти."},
 {"scene":0,"text":3,"speaker":"Мику","translation":"Извини, что беспокою."},
 {"scene":0,"text":4,"speaker":"Футаро","translation":"Пришла меня разбудить?\\nСпасибо."},
 {"scene":0,"text":5,"speaker":"Мику","translation":"......"},
 {"scene":0,"text":6,"speaker":"Футаро","translation":"Что, что такое?\\nУ меня что-то на лице?"},
 {"scene":0,"text":7,"speaker":"Мику","translation":"Сегодня я первая."},
 {"scene":0,"text":8,"speaker":"Футаро","translation":"А? Первая?"},
 {"scene":0,"text":9,"speaker":"Мику","translation":"Тебе не обязательно знать, Футаро."},
 {"scene":0,"text":10,"speaker":"Футаро","translation":"Эх..."},
 {"scene":0,"text":11,"speaker":"Мику","translation":"Я пойду, хорошо?\\nНо если скоро не придёшь, я съем твою порцию, Футаро."},
 {"scene":0,"text":12,"speaker":"Футаро","translation":"ЧТО?!\\nП-погоди, Мику! Я сейчас приду!"}
]
