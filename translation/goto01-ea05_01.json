[
 {"scene":0,"text":0,"speaker":"Мику","translation":"О, смузи.\\nИнтересно, можно попробовать?"},
 {"scene":0,"text":1,"speaker":"Райха","translation":"А!! Мику-сан, ПОГОДИ!"},
 {"scene":0,"text":2,"speaker":"Мику","translation":"КХ?!"},
 {"scene":0,"text":3,"speaker":"Мику","translation":"К-какая ужасная горечь...\\nЯ думала, будет вкусно, как зелёный чай..."},
 {"scene":0,"text":4,"speaker":"Футаро","translation":"Ты в порядке?\\nПохоже, туда положили овощи,\\nкоторые не подходят для смузи."},
 {"scene":0,"text":5,"speaker":"Ёцуба","translation":"ОГО! Смузи?\\nТогда и я попробую!"},
 {"scene":0,"text":6,"speaker":"Обе","translation":"А!!"},
 {"scene":0,"text":7,"speaker":"Ёцуба","translation":"...?!"},
 {"scene":0,"text":8,"speaker":"Райха","translation":"Ё-ЁЦУБА-СА-АН!!"},
 {"scene":0,"text":9,"speaker":"Мику","translation":"Футаро! Принеси воды!!"}
]
