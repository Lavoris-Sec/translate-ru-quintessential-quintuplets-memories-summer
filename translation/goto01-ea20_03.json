[
 {"scene":0,"text":0,"speaker":"Райха","translation":"Какая вкусная никузяга!"},
 {"scene":0,"text":1,"speaker":"Мику","translation":"Картошка такая рассыпчатая..."},
 {"scene":0,"text":2,"speaker":"Ёцуба","translation":"Она хорошо пропиталась вкусом\\nи сохранила форму — просто идеально!"},
 {"scene":0,"text":3,"speaker":"Футаро","translation":"Картошка прямо блестит."},
 {"scene":0,"text":4,"speaker":"Нино","translation":"Иначе говоря, блеск идеальный."}
